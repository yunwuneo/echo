PUBLIC_URL=https://echo.example.com
POSTGRES_PASSWORD=replace-with-a-random-database-password
MASTER_KEY=replace-with-64-hex-characters
MASTER_KEY_VERSION=1
FOREGROUND_DAILY_REQUEST_LIMIT=100
# Local source development only:
# DATABASE_URL=postgresql://echo2:password@127.0.0.1:5432/echo2
# ALLOW_INSECURE_LOCAL=true
# PUBLIC_URL=http://localhost:3000

# Conservative shared daily budget for memory extraction, indexing and semantic queries (configured IANA timezone).
BACKGROUND_DAILY_REQUEST_LIMIT=20
BACKGROUND_DAILY_INPUT_LIMIT=100000
BACKGROUND_DAILY_OUTPUT_LIMIT=10000

# Optional relay HTTPS origin; empty disables system push.
PUSH_RELAY_URL=
ECHO_IMAGE=echo2-server:0.5.0
